# ============================================================================
# eVTOL Charging (arm) — environment template
# Copy to `.env` and fill in. `.env` is gitignored — NEVER commit secrets.
# Manual account/key steps: docs/SETUP.md.  Status check:
#   python3 scripts/check_credentials.py
# ============================================================================

# ----------------------------------------------------------------------------
# NEBIUS CLOUD — all GPU compute via the `npa` CLI (Nebius Physical AI).
# Preemptible VMs only. `npa cleanup` + `npa destroy` after EVERY session.
# ----------------------------------------------------------------------------

# Project ID from the Nebius console (IAM → Projects). Required.
NEBIUS_PROJECT_ID=

# IAM token for Nebius Cloud API access.
# NOTE: `npa configure` also writes credentials to ~/.npa/credentials — that
# file is the primary npa auth path. This env var is for raw API calls and
# tools that read env vars. Either is acceptable; prefer npa configure.
NEBIUS_IAM_TOKEN=

# Nebius object storage (S3-compatible) — every captured episode auto-uploads.
# EVDATA_BUCKET: bucket name for episode data (create in console or via npa).
# NEBIUS_S3_ENDPOINT: regional S3 endpoint, e.g.
#   https://storage.eu-north1.nebius.cloud   (adjust to your project region)
EVDATA_BUCKET=
NEBIUS_S3_ENDPOINT=https://storage.eu-north1.nebius.cloud

# ----------------------------------------------------------------------------
# NEBIUS TOKEN FACTORY — OpenAI-compatible model serving for the Nemotron
# permit reasoner. This key is SEPARATE from the Nebius Cloud IAM token;
# create it in the Token Factory console (docs/SETUP.md step 5).
# ----------------------------------------------------------------------------

TOKEN_FACTORY_API_KEY=

# OpenAI-compatible base URL — default below is correct for us-central1.
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# Nemotron model ID served by Token Factory. Placeholder pending the day-1
# contract freeze — the plan does not pin Nano/Super/Ultra.
PERMIT_MODEL_ID=nvidia/nemotron-3-super-120b-a12b

# ----------------------------------------------------------------------------
# NVIDIA NGC — pull Isaac Sim / GR00T / Cosmos containers from nvcr.io.
# Also used for `docker login nvcr.io` (username: $oauthtoken).
# ----------------------------------------------------------------------------
NGC_API_KEY=

# ----------------------------------------------------------------------------
# HUGGING FACE — token must have accepted the gated terms for:
#   nvidia/GR00T-N1.7-3B      (policy)
#   nvidia/Cosmos-Reason2-2B  (GR00T backbone — SEPARATE gate, plan misses it)
#   nvidia/Cosmos3-Super      (generation sweeps — plus Cosmos3-Edge for Orin)
# Create at https://huggingface.co/settings/tokens (read scope is enough).
# ----------------------------------------------------------------------------
HF_TOKEN=

# ----------------------------------------------------------------------------
# REMOTE RIG ACCESS — Tailscale so both sites reach the rig by stable name
# with no port forwarding. Authkey from the Tailscale admin console.
# Leave empty to run interactive `tailscale up` on the rig host instead.
# ----------------------------------------------------------------------------
TAILSCALE_AUTHKEY=

# ----------------------------------------------------------------------------
# EVENT BUS — single API surface for the rig ("nobody SSHes in to poke
# servos ad hoc"). Technology TBD at the day-1 freeze (MQTT / Redis /
# WebSocket) — see docs/CONTRACTS.md §3. Topics live in src/evtol/topics.py.
# Example: mqtt://rig.tailnet-name:1883  or  redis://rig:6379
# ----------------------------------------------------------------------------
EVENT_BUS_URL=

# ----------------------------------------------------------------------------
# DATA — LeRobot v3 dataset root (v3 only, never mix v2.1 paths).
# ----------------------------------------------------------------------------
LEROBOT_DATASET_ROOT=./data/lerobot

# ----------------------------------------------------------------------------
# SAFETY / OPS — hard kill-timer (seconds) enforced on EVERY scheduled job
# (nightly fine-tune + eval fan-out fire ~22:30). Unattended billing is the
# feared failure mode — do not raise without a CHANGELOG entry.
# ----------------------------------------------------------------------------
JOB_KILL_TIMEOUT=3600
