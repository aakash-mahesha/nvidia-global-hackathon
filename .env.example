# ============================================================================
# eVTOL Charging (arm) — PERSONAL secrets template → copy to `.env` and fill.
# `.env` is gitignored — NEVER commit secrets.
#
# Config layering (see src/evtol/config.py):
#   real env vars  >  .env (this file, personal secrets + overrides)
#                  >  .env.shared (COMMITTED team values — see bottom)
#
# Each dev uses their OWN accounts/keys below; you were invited to the team
# Nebius tenant, so shared resource IDs already come from .env.shared.
# Manual account/key steps: docs/SETUP.md.  Status check:
#   python3 scripts/check_credentials.py
# ============================================================================

# ----------------------------------------------------------------------------
# NEBIUS CLOUD — your personal IAM identity on the TEAM tenant (docs/SETUP.md
# section 0). `npa configure` also writes ~/.npa/credentials — that file is
# the primary npa auth path; this var is for raw API calls / env-based tools.
# ----------------------------------------------------------------------------
NEBIUS_IAM_TOKEN=

# ----------------------------------------------------------------------------
# NEBIUS TOKEN FACTORY — YOUR key from the Token Factory console. SEPARATE
# from the Nebius Cloud IAM token (docs/SETUP.md step 5).
# ----------------------------------------------------------------------------
TOKEN_FACTORY_API_KEY=

# ----------------------------------------------------------------------------
# NVIDIA NGC — your personal key for nvcr.io pulls (Isaac Sim / GR00T /
# Cosmos containers). `docker login nvcr.io` — username: $oauthtoken.
# ----------------------------------------------------------------------------
NGC_API_KEY=

# ----------------------------------------------------------------------------
# HUGGING FACE — your token must have accepted the gated terms for:
#   nvidia/GR00T-N1.7-3B      (policy)
#   nvidia/Cosmos-Reason2-2B  (GR00T backbone — SEPARATE gate, plan misses it)
#   nvidia/Cosmos3-Super      (generation sweeps — plus Cosmos3-Edge for Orin)
# Create at https://huggingface.co/settings/tokens (read scope is enough).
# ----------------------------------------------------------------------------
HF_TOKEN=

# ----------------------------------------------------------------------------
# TAILSCALE — authkey for the rig host (tailnet admin generates it).
# Leave empty to run interactive `tailscale up` on the rig host instead.
# ----------------------------------------------------------------------------
TAILSCALE_AUTHKEY=

# ============================================================================
# SHARED values — normally inherited from the committed .env.shared file.
# Only set these in .env to OVERRIDE, e.g. scratch work on your own tenant
# (billing can't merge, so project artifacts must stay on the team tenant).
# ============================================================================
# NEBIUS_PROJECT_ID=            # team project — owner fills in .env.shared
# EVDATA_BUCKET=                # episode bucket — owner fills in .env.shared
# NEBIUS_S3_ENDPOINT=https://storage.eu-north1.nebius.cloud
# TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
# PERMIT_MODEL_ID=nvidia/nemotron-3-super-120b-a12b   # pin real SKU at freeze
# EVENT_BUS_URL=                # e.g. mqtt://rig.<tailnet>:1883
# LEROBOT_DATASET_ROOT=./data/lerobot   # LeRobot v3 only, never v2.1 paths
# JOB_KILL_TIMEOUT=3600         # hard kill-timer (s) on EVERY scheduled job
