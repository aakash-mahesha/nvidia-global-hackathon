# ============================================================================
# eVTOL Charging (arm) — TEAM-SHARED, non-secret config (COMMITTED to git)
#
# Values here point at the ONE team Nebius tenant owned by B1 — Nebius
# billing is per-tenant and cannot merge across tenants, so all project
# resources (GPU jobs, episode bucket, scheduled jobs) live in this project.
#
# Secrets do NOT belong in this file. Personal keys go in your gitignored
# `.env` (copy .env.example). To do scratch work on your OWN tenant, set
# NEBIUS_PROJECT_ID + EVDATA_BUCKET in `.env` — it overrides this file.
#
# Filled once by the tenant owner (B1) during docs/SETUP.md section 0 setup.
# ============================================================================

# --- Nebius Cloud (team tenant) ---
# The team project ID all devs/jobs share. Owner fills after section-0 setup.
NEBIUS_PROJECT_ID=

# Object-storage bucket every captured episode auto-uploads to.
EVDATA_BUCKET=
NEBIUS_S3_ENDPOINT=https://storage.eu-north1.nebius.cloud

# --- Token Factory (endpoint shared; YOUR key stays in .env) ---
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
PERMIT_MODEL_ID=nvidia/nemotron-3-super-120b-a12b

# --- Event bus (runs on the rig host, reached over Tailscale) ---
EVENT_BUS_URL=

# --- Data / ops ---
LEROBOT_DATASET_ROOT=./data/lerobot
JOB_KILL_TIMEOUT=3600
